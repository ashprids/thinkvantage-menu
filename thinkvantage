# ============================================================

menu_tools() {

    local choice

    choice="$(
        menu \
            "Tools" \
            "Terminal" \
            "Calculator" \
            "Colour Picker" \
            "Character Map" \
            "Kill Window" \
            "Process Search" \
            "Environment Information" \
            "Mounted Drives" \
            "Journal" \
            "Back"
    )"


    case "$choice" in

        "Terminal")
            run_bg \
                gnome-terminal
            ;;


        "Calculator")
            run_bg \
                qalculate-gtk
            ;;


        "Colour Picker")
            run_bg \
                gpick
            ;;


        "Character Map")
            run_bg \
                gucharmap
            ;;


        "Kill Window")
            xkill
            exit 0
            ;;


        "Process Search")

            local process
            local pid

            process="$(
                ps \
                    -eo pid,comm,%cpu,%mem \
                    --sort=-%cpu |
                rofi \
                    -dmenu \
                    -i \
                    -p "Processes"
            )"

            pid="$(
                awk \
                    '{print $1}' \
                    <<< "$process"
            )"

            if [[ "$pid" =~ ^[0-9]+$ ]]; then
                kill "$pid"
            fi

            exit 0
            ;;


        "Environment Information")
            terminal_run \
                "120x35" \
                "System Information" \
                "uname -a; echo; lscpu; echo; free -h"
            ;;


        "Mounted Drives")
            terminal_run \
                "120x30" \
                "Mounted Drives" \
                "lsblk -o NAME,SIZE,FSTYPE,FSUSE%,MOUNTPOINTS,MODEL"
            ;;


        "Journal")
            terminal_run \
                "140x40" \
                "Journal" \
                "journalctl -f"
            ;;


        "Back")
            return
            ;;


        *)
            exit 0
            ;;

    esac
}


