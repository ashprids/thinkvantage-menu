SCREENSHOT_DIR="$HOME/Pictures/Screenshots"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/thinkvantage"
TERM_APP="gnome-terminal"

mkdir -p "$SCREENSHOT_DIR" "$CACHE_DIR"

# Save the window focused before rofi appears.
# This is used for Active Window screenshots.
ORIGINAL_WINDOW="$(xdotool getactivewindow 2>/dev/null || true)"

# Prefer the X230's Intel backlight device.
if [[ -e /sys/class/backlight/intel_backlight ]]; then
    BACKLIGHT_DEVICE="intel_backlight"
else
    BACKLIGHT_DEVICE="$(
        ls /sys/class/backlight 2>/dev/null |
        head -n1
    )"
fi


# ============================================================
# helpers
# ============================================================

menu() {
    local prompt="$1"
    shift

    printf '%s\n' "$@" |
        rofi -dmenu -i -p "$prompt"
}


missing() {
    notify-send \
        "ThinkVantage" \
        "Command not found: $1"
}


run_bg() {
    local command="$1"

    if ! command -v "$command" >/dev/null 2>&1; then
        missing "$command"
        exit 1
    fi

    nohup "$@" >/dev/null 2>&1 &
    disown

    # Launching anything closes ThinkVantage completely.
    exit 0
}


run_flatpak() {
    local appid="$1"

    if ! command -v flatpak >/dev/null 2>&1 ||
       ! flatpak info "$appid" >/dev/null 2>&1
    then
        notify-send \
            "ThinkVantage" \
            "Flatpak not installed: $appid"

        exit 1
    fi

    nohup flatpak run "$appid" \
        >/dev/null 2>&1 &

    disown
    exit 0
}


terminal_run() {
    local geometry="$1"
    local title="$2"
    local command="$3"

    if ! command -v "$TERM_APP" >/dev/null 2>&1; then
        missing "$TERM_APP"
        exit 1
    fi

    nohup "$TERM_APP" \
        --geometry="$geometry" \
        --title="$title" \
        -- bash -lc "$command; exec bash" \
        >/dev/null 2>&1 &

    disown
    exit 0
}


confirm() {
    printf 'No\nYes\n' |
        rofi -dmenu -i -p "$1" |
        grep -qx "Yes"
}


# ============================================================
# flameshot
#
# Supports both:
#   apt/native Flameshot
#   Flatpak Flameshot
# ============================================================

flameshot_run() {
    if command -v flameshot >/dev/null 2>&1; then
        command flameshot "$@"
        return $?
    fi

    if command -v flatpak >/dev/null 2>&1 &&
       flatpak info org.flameshot.Flameshot >/dev/null 2>&1
    then
        flatpak run \
            org.flameshot.Flameshot \
            "$@"

        return $?
    fi

    notify-send \
        "ThinkVantage" \
        "Flameshot is not installed."

    return 127
}


# ============================================================
# screenshots
# ============================================================

capture_display() {
    # Let rofi disappear completely before capturing.
    sleep 0.15

    if flameshot_run \
        screen \
        --path "$SCREENSHOT_DIR"
    then
        notify-send \
            "Screenshot" \
            "Display screenshot saved to ~/Pictures/Screenshots."
    else
        notify-send \
            "Screenshot" \
            "Display screenshot failed."
    fi

    exit 0
}


capture_all_displays() {
    sleep 0.15

    if flameshot_run \
        full \
        --path "$SCREENSHOT_DIR"
    then
        notify-send \
            "Screenshot" \
            "All-displays screenshot saved to ~/Pictures/Screenshots."
    else
        notify-send \
            "Screenshot" \
            "All-displays screenshot failed."
    fi

    exit 0
}


capture_active_window() {
    local id="$ORIGINAL_WINDOW"

    if [[ -z "$id" ]] ||
       ! xwininfo -id "$id" >/dev/null 2>&1
    then
        notify-send \
            "Screenshot" \
            "Could not find the window that was active before ThinkVantage opened."

        exit 1
    fi


    # -----------------------------
    # get client window geometry
    # -----------------------------

    local info
    local x
    local y
    local width
    local height

    info="$(xwininfo -id "$id")"

    x="$(
        awk \
            '/Absolute upper-left X:/ {print $4}' \
            <<< "$info"
    )"

    y="$(
        awk \
            '/Absolute upper-left Y:/ {print $4}' \
            <<< "$info"
    )"

    width="$(
        awk \
            '/Width:/ {print $2; exit}' \
            <<< "$info"
    )"

    height="$(
        awk \
            '/Height:/ {print $2; exit}' \
            <<< "$info"
    )"


    # -----------------------------
    # add Cinnamon/Muffin borders
    # and titlebar
    # -----------------------------

    local extents

    extents="$(
        xprop \
            -id "$id" \
            _NET_FRAME_EXTENTS \
            2>/dev/null |
        sed -n 's/.*= //p' |
        tr -d ','
    )"


    if [[ -n "$extents" ]]; then
        local left
        local right
        local top
        local bottom

        read -r \
            left \
            right \
            top \
            bottom \
            <<< "$extents"

        x=$((x - left))
        y=$((y - top))

        width=$((width + left + right))
        height=$((height + top + bottom))
    fi


    local region="${width}x${height}+${x}+${y}"


    # Put the original window back in front.
    # This also makes sure Flameshot doesn't accidentally
    # immortalise rofi instead.
    xdotool \
        windowactivate \
        --sync \
        "$id" \
        >/dev/null 2>&1 ||
        true


    sleep 0.15


    # Use the entire desktop as Flameshot's source,
    # then crop to our calculated window rectangle.
    if flameshot_run \
        full \
        --region "$region" \
        --path "$SCREENSHOT_DIR"
    then
        notify-send \
            "Screenshot" \
            "Active-window screenshot saved to ~/Pictures/Screenshots."
    else
        notify-send \
            "Screenshot" \
            "Active-window screenshot failed."
    fi

    exit 0
}


# ============================================================
# brightness
# ============================================================

set_brightness() {
    local value="$1"

    if ! command -v brightnessctl >/dev/null 2>&1; then
        missing "brightnessctl"
        exit 1
    fi


    if [[ -z "$BACKLIGHT_DEVICE" ]]; then
        notify-send \
            "Brightness" \
            "No backlight device was found."

        exit 1
    fi


    local output

    if output="$(
        brightnessctl \
            --device="$BACKLIGHT_DEVICE" \
            set "$value" \
            2>&1
    )"
    then

        local current
        local maximum
        local percent

        current="$(
            brightnessctl \
                --device="$BACKLIGHT_DEVICE" \
                get \
                2>/dev/null
        )"

        maximum="$(
            brightnessctl \
                --device="$BACKLIGHT_DEVICE" \
                max \
                2>/dev/null
        )"


        if [[ "$current" =~ ^[0-9]+$ ]] &&
           [[ "$maximum" =~ ^[0-9]+$ ]] &&
           [[ "$maximum" -gt 0 ]]
        then
            percent=$((current * 100 / maximum))

            notify-send \
                "Brightness" \
                "Brightness: ${percent}%"
        else
            notify-send \
                "Brightness" \
                "Brightness changed."
        fi

    else

        notify-send \
            "Brightness failed" \
            "$output"

    fi

    exit 0
}


# ============================================================
# special launchers
# ============================================================

launch_easyeffects() {

    # Native package
    if command -v easyeffects >/dev/null 2>&1; then
        run_bg easyeffects
    fi


    # Flatpak
    if command -v flatpak >/dev/null 2>&1 &&
       flatpak info \
           com.github.wwmm.easyeffects \
           >/dev/null 2>&1
    then
        run_flatpak \
            com.github.wwmm.easyeffects
    fi


    notify-send \
        "ThinkVantage" \
        "EasyEffects is not installed."

    exit 1
}


launch_fsearch() {

    # Native / PPA
    if command -v fsearch >/dev/null 2>&1; then
        run_bg fsearch
    fi


    # Flatpak
    if command -v flatpak >/dev/null 2>&1 &&
       flatpak info \
           io.github.cboxdoerfer.FSearch \
           >/dev/null 2>&1
    then
        run_flatpak \
            io.github.cboxdoerfer.FSearch
    fi


    notify-send \
        "ThinkVantage" \
        "FSearch is not installed."

    exit 1
}


# ============================================================
# clipboard
# ============================================================

clipboard_history() {

    if ! command -v copyq >/dev/null 2>&1; then
        missing "copyq"
        exit 1
    fi


    # Starts CopyQ if it isn't already running,
    # then opens its main window.
    nohup copyq \
        --start-server \
        show \
        >/dev/null 2>&1 &

    disown
    exit 0
}


display_clipboard() {

    if ! command -v xclip >/dev/null 2>&1; then
        missing "xclip"
        exit 1
    fi


    local file="$CACHE_DIR/current-clipboard.txt"


    if xclip \
        -selection clipboard \
        -o \
        > "$file" \
        2>/dev/null
    then
        run_bg \
            xed \
            "$file"
    else
        notify-send \
            "Clipboard" \
            "Could not read text from the clipboard."

        exit 1
    fi
}


